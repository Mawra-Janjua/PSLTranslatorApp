<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PSLTranslatorApp">

        <!-- Launcher -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Activities -->
        <activity android:name=".ui.HomeActivity" android:exported="false"/>
        <activity android:name=".ui.CaptureActivity" android:exported="false" android:screenOrientation="portrait"/>
        <activity android:name=".ui.PracticeActivity" android:exported="false"/>
        <activity android:name=".ui.LearningMenuActivity" android:exported="false"/>
        <activity android:name=".admin.AdminActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
<activity
        android:name=".ui.ProgressActivity"
        android:exported="false" />

        <activity android:name=".ui.EnglishAlphabetActivity" android:exported="false"/>
        <activity android:name=".ui.UrduAlphabetActivity" android:exported="false"/>
        <activity android:name=".ui.NumbersActivity" android:exported="false"/>
        <activity android:name=".ui.VideoPlayerActivity" android:exported="false"/>
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />
    </application>
</manifest>